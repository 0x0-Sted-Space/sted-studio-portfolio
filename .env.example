# Environment Variables Template for Sted Studio Portfolio
# Copy this file to .env.local for local development
# Set these variables in your deployment platform (Vercel, Netlify, Coolify, etc.)

# Node Environment (automatically set by most platforms)
NODE_ENV=production

# Deployment URL (automatically set by platforms)
# Vercel: VERCEL_URL=your-domain.vercel.app
# Coolify: Set your custom domain in Coolify dashboard
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Next.js Internationalization
# Add your supported locales if you expand beyond the current setup
# NEXT_PUBLIC_DEFAULT_LOCALE=en

# Analytics (optional - add if you want to track visitors)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# Contact Form (if you add contact functionality)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@stedstudio.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Content Management (if you add CMS integration)
# NEXT_PUBLIC_CMS_URL=your_cms_url
# CMS_API_KEY=your_cms_api_key

# StackAuth Configuration
# Get these from your StackAuth dashboard: https://app.stack-auth.com
# Create a new project and copy the credentials
NEXT_PUBLIC_STACK_PROJECT_ID=your_stack_project_id_here
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_stack_publishable_key_here
STACK_SECRET_SERVER_KEY=your_stack_secret_key_here

# Application URLs (Update these for your project)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: App identifier for multi-app setups
NEXT_PUBLIC_APP_NAME=sted-studio-portfolio

# Database (Update this for your project if needed)
# DATABASE_URL="postgresql://your_user:your_password@your_host:5432/your_database"

# Optional: Medusa backend (if using e-commerce features)
# NEXT_PUBLIC_MEDUSA_BACKEND_URL="http://localhost:9000"