#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔒 Running security checks..."

# Check for secrets in staged markdown files
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$')

if [ -n "$STAGED_MD_FILES" ]; then
  echo "Checking markdown files for secrets..."
  
  for file in $STAGED_MD_FILES; do
    # Check for environment variable assignments with non-placeholder values
    if git diff --cached "$file" | grep -E "^\+.*=(sk_|pk_|proj_)[a-zA-Z0-9_]{20,}"; then
      echo "❌ ERROR: Potential secret detected in $file"
      echo "Markdown files should only contain placeholder values like 'your_key_here'"
      exit 1
    fi
    
    # Check for JWT tokens
    if git diff --cached "$file" | grep -E "^\+.*eyJ[a-zA-Z0-9_-]{20,}"; then
      echo "❌ ERROR: Potential JWT token detected in $file"
      exit 1
    fi
  done
  
  echo "✅ No secrets detected in markdown files"
fi

# Check if .env.local or .env.production are being committed
if git diff --cached --name-only | grep -E "^\.env\.(local|production)$"; then
  echo "❌ ERROR: Attempting to commit secret files (.env.local or .env.production)"
  echo "These files should never be committed to git"
  exit 1
fi

echo "✅ Security checks passed"
